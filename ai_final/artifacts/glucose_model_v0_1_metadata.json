{
  "version": "glucose_model_v0.1",
  "task": "glucose_regression",
  "target": "GlukosaRef",
  "features": [
    "Usia",
    "Berat_kg",
    "Tinggi_cm",
    "BMI",
    "TerakhirMakan_jam",
    "SuhuTubuh",
    "SuhuAmbient",
    "HR_est",
    "SpO2_est",
    "IR_Mean",
    "IR_Min",
    "IR_Max",
    "IR_Std",
    "IR_RMS",
    "RED_Mean",
    "RED_Min",
    "RED_Max",
    "RED_Std",
    "RED_RMS",
    "Ratio_AC",
    "Ratio_DC",
    "Samples"
  ],
  "model": "RandomForestRegressor",
  "parameters": {
    "enabled": true,
    "n_estimators": 200,
    "max_depth": 6,
    "min_samples_leaf": 2,
    "random_state": 42,
    "n_jobs": -1
  },
  "training_rows": 40,
  "training_subjects": 32,
  "evaluation_report": "reports/model_comparison.json",
  "warning": "Full-data artifact for offline inspection only; not clinical validation and not directly executable on Arduino."
}
